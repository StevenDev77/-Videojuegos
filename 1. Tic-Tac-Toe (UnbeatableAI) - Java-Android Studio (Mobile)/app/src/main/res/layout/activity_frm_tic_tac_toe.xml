<?xml version="1.0" encoding="utf-8"?>
<!--
    Android equivalent of frmTicTacToe.Designer.cs.

    The original form is 279 x 420 px at 96 DPI. Its fixed coordinates are
    reproduced here as dp. The nine board buttons keep the original positions:
        x = 30, 96, 162       y = 19, 85, 151
    Each button is 60 x 60.

    Font size conversion: the original uses points at 96 DPI, so
        20.25 pt -> 27 sp      (btnTicTacToe2..9)
        19.8 pt  -> 26.4 sp    (btnTicTacToe1)
        12 pt    -> 16 sp      (lblInformation)
    The Windows "Ravie" font is not available on Android, so a bold
    sans-serif font is used instead.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="279dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- grbInformation -->
        <RelativeLayout
            android:id="@+id/grb_information"
            android:layout_width="259dp"
            android:layout_height="95dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/group_box_background">

            <ImageView
                android:id="@+id/pic_character"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="19dp"
                android:contentDescription="@string/pic_character_description"
                android:scaleType="fitCenter"
                android:src="@drawable/pocoyo_bailando" />

            <TextView
                android:id="@+id/lbl_information"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="76dp"
                android:layout_marginTop="45dp"
                android:fontFamily="sans-serif"
                android:text="@string/lbl_information"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- grbTicTacToe -->
        <RelativeLayout
            android:id="@+id/grb_tic_tac_toe"
            android:layout_width="259dp"
            android:layout_height="225dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="7dp"
            android:background="@drawable/group_box_background">

            <Button
                android:id="@+id/btn_tic_tac_toe_1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="19dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="0"
                android:textSize="26.4sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tic_tac_toe_2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="96dp"
                android:layout_marginTop="19dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="1"
                android:textSize="27sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tic_tac_toe_3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="162dp"
                android:layout_marginTop="19dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="2"
                android:textSize="27sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tic_tac_toe_4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="85dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="3"
                android:textSize="27sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tic_tac_toe_5"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="96dp"
                android:layout_marginTop="85dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="4"
                android:textSize="27sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tic_tac_toe_6"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="162dp"
                android:layout_marginTop="85dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="5"
                android:textSize="27sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tic_tac_toe_7"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="151dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="6"
                android:textSize="27sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tic_tac_toe_8"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="96dp"
                android:layout_marginTop="151dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="7"
                android:textSize="27sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tic_tac_toe_9"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="162dp"
                android:layout_marginTop="151dp"
                android:fontFamily="sans-serif"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:tag="8"
                android:textSize="27sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- grbOptions -->
        <RelativeLayout
            android:id="@+id/grb_options"
            android:layout_width="259dp"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/group_box_background">

            <Button
                android:id="@+id/btn_new"
                android:layout_width="88dp"
                android:layout_height="23dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="19dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/btn_new"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_exit"
                android:layout_width="87dp"
                android:layout_height="23dp"
                android:layout_marginStart="135dp"
                android:layout_marginTop="19dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="@string/btn_exit"
                android:textSize="11sp" />
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
