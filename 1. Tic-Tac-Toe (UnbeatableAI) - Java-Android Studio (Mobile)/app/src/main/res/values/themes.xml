<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        WinForms Form default theme equivalent.
        The original Form used the operating system's default gray window and
        control style; this platform theme is the closest stock Android match.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/form_background</item>
    </style>
</resources>
